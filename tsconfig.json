{
  "extends": "expo/tsconfig.base",
  "noImplicitAny": false,
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": true,
    "strict": false,
    "module": "esnext",
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
