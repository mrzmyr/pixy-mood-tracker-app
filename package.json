{
  "name": "pixel-tracker",
  "version": "1.98.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare": "husky",
    "start": "EXPO_PUBLIC_APP_VARIANT=development expo start --dev-client",
    "android": "bun scripts/run-native.ts android",
    "ios": "bun scripts/run-native.ts ios",
    "ios:preview": "EXPO_PUBLIC_APP_VARIANT=preview bun scripts/run-native.ts ios --configuration Release --no-bundler",
    "android:preview": "EXPO_PUBLIC_APP_VARIANT=preview bun scripts/run-native.ts android --variant release --no-bundler",
    "app": "bun scripts/cli/index.ts app",
    "e2e": "bun scripts/cli/index.ts e2e",
    "devices": "bun scripts/cli/index.ts devices",
    "builds": "bun scripts/cli/index.ts builds",
    "worktree": "bun scripts/cli/index.ts worktree",
    "test:cli": "bun test scripts/cli scripts/check-locales scripts/sort-locales scripts/generate-licenses",
    "web": "EXPO_PUBLIC_APP_VARIANT=development expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest",
    "eas:ios:dev": "bunx eas-cli build -p ios --local --profile=development",
    "eas:android:dev": "bunx eas-cli build -p android --local --profile=development",
    "eas:ios:emulator": "bunx eas-cli build -p ios --profile=emulator",
    "eas:android:emulator": "bunx eas-cli build -p android --profile=emulator",
    "eas:ios:preview": "bunx eas-cli build -p ios --local --profile=preview",
    "eas:android:preview": "bunx eas-cli build -p android --local --profile=preview",
    "eas:ios:prod": "bunx eas-cli build -p ios --local --profile=production",
    "eas:android:prod": "bunx eas-cli build -p android --local --profile=production",
    "submit": "bunx eas-cli submit -p android --path $(ls -t *.aab | head -1) && bunx eas-cli submit -p ios --path $(ls -t *.ipa | head -1)",
    "eas:preview": "bun run eas:ios:preview && bun run eas:android:preview",
    "eas:prod": "bun run eas:ios:prod && bun run eas:android:prod",
    "translate-app": "bun scripts/generate-translations-app.js",
    "licenses": "bun scripts/generate-licenses.ts",
    "reviews": "node scripts/store-reviews.mjs",
    "type-check": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check && bun run type-check && bun run check:locales && bun run i18n:sort:check",
    "check:locales": "bun scripts/check-locales.ts",
    "fix": "bun run i18n:sort && oxlint --fix && oxfmt",
    "i18n:sort": "bun scripts/sort-locales.ts",
    "i18n:sort:check": "bun scripts/sort-locales.ts --check"
  },
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@hugeicons/core-free-icons": "4.3.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "^2.3.2",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.7",
    "expo": "~58.0.14",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-contacts": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.4",
    "expo-location": "~58.0.17",
    "expo-maps": "~58.0.9",
    "expo-media-library": "~58.0.10",
    "expo-notifications": "~58.1.5",
    "expo-observe": "~58.0.15",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-store-review": "~58.0.2",
    "expo-superwall": "1.2.0",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.20",
    "fast-xml-parser": "^5.10.1",
    "i18n-js": "^4.5.3",
    "lodash": "^4.17.21",
    "lucide-react-native": "^1.48.0",
    "posthog-react-native": "^4.75.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-carousel": "^5.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-sortables": "^1.10.1",
    "react-native-style-utilities": "^1.0.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "semver": "^7.5.2",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@google-cloud/translate": "^10.1.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/i18n-js": "^4.0.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/react": "~19.3.0",
    "agent-device": "0.21.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "test-renderer": "^1.3.0",
    "typescript": "~7.0.2",
    "ultracite": "7.12.0"
  },
  "overrides": {
    "markdown-it": "^15.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": "oxlint --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "jest": {
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.+)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "preset": "jest-expo",
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "./__tests__/utils.ts",
      "<rootDir>/scripts/"
    ],
    "transform": {
      "\\.txt$": "jest-expo/src/preset/assetFileTransformer.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/.*|native-base|standard-navigation|uuid))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "engines": {
    "node": ">=22.13 <27"
  },
  "packageManager": "bun@1.3.5",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-maps"
        ]
      }
    },
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "typescript"
      ]
    }
  }
}
