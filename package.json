{
  "name": "pixel-tracker",
  "version": "1.110.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare": "husky",
    "start": "EXPO_PUBLIC_APP_VARIANT=development expo start --dev-client",
    "android": "bun scripts/run-native.ts android",
    "ios": "bun scripts/run-native.ts ios",
    "ios:preview": "EXPO_PUBLIC_APP_VARIANT=preview bun scripts/run-native.ts ios --configuration Release --no-bundler",
    "android:preview": "EXPO_PUBLIC_APP_VARIANT=preview bun scripts/run-native.ts android --variant release --no-bundler",
    "app": "bun scripts/cli/index.ts app",
    "e2e": "bun scripts/cli/index.ts e2e",
    "devices": "bun scripts/cli/index.ts devices",
    "builds": "bun scripts/cli/index.ts builds",
    "hub": "expo-device-hub --hide-boot-device",
    "release": "bun scripts/cli/index.ts release",
    "worktree": "bun scripts/cli/index.ts worktree",
    "test:cli": "bun test scripts/cli scripts/codemods scripts/check-locales scripts/sort-locales scripts/generate-licenses",
    "web": "EXPO_PUBLIC_APP_VARIANT=development expo start --web",
    "test": "jest --watchAll --env=jsdom",
    "test:ci": "jest --env=jsdom",
    "eas:ios:dev": "bunx eas-cli build -p ios --local --profile=development",
    "eas:android:dev": "bunx eas-cli build -p android --local --profile=development",
    "eas:ios:emulator": "bunx eas-cli build -p ios --profile=emulator",
    "eas:android:emulator": "bunx eas-cli build -p android --profile=emulator",
    "eas:ios:preview": "bunx eas-cli build -p ios --local --profile=preview",
    "eas:android:preview": "bunx eas-cli build -p android --local --profile=preview",
    "eas:ios:prod": "bunx eas-cli build -p ios --local --profile=production",
    "eas:android:prod": "bunx eas-cli build -p android --local --profile=production",
    "submit": "bunx eas-cli submit -p android --path $(ls -t *.aab | head -1) && bunx eas-cli submit -p ios --path $(ls -t *.ipa | head -1)",
    "eas:preview": "bun run eas:ios:preview && bun run eas:android:preview",
    "eas:prod": "bun run eas:ios:prod && bun run eas:android:prod",
    "translate-app": "bun scripts/generate-translations-app.js",
    "licenses": "bun scripts/generate-licenses.ts",
    "reviews": "node scripts/store-reviews.mjs",
    "type-check": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check && bun run type-check && bun run check:locales && bun run i18n:sort:check",
    "check:locales": "bun scripts/check-locales.ts",
    "fix": "bun run i18n:sort && oxlint --fix && oxfmt",
    "i18n:sort": "bun scripts/sort-locales.ts",
    "i18n:sort:check": "bun scripts/sort-locales.ts --check"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.25",
    "@hugeicons/core-free-icons": "4.3.5",
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "@nandorojo/galeria": "^3.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/elements": "^2.9.43",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.3.3",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.7",
    "expo": "~57.0.30",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-contacts": "~57.0.8",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-maps": "~57.0.4",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.23",
    "expo-observe": "~57.0.25",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
    "expo-speech-transcriber": "0.1.9",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-superwall": "1.2.0",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.26",
    "i18n-js": "^4.5.3",
    "lodash": "^4.17.21",
    "lucide-react-native": "^1.55.0",
    "posthog-react-native": "^4.75.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-carousel": "^5.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.27.0",
    "react-native-sortables": "^1.10.1",
    "react-native-style-utilities": "^1.0.1",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1",
    "semver": "^7.5.2",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@google-cloud/translate": "^10.2.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/i18n-js": "^4.0.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.10",
    "agent-device": "0.21.25",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo-device-hub": "^0.17.1",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.6",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.87.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "test-renderer": "^1.3.0",
    "typescript": "~7.0.2",
    "ultracite": "7.12.0"
  },
  "overrides": {
    "markdown-it": "^15.0.0",
    "react-native-screens": "~4.27.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": "oxlint --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "jest": {
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.+)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "preset": "jest-expo",
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "./__tests__/utils.ts",
      "<rootDir>/scripts/"
    ],
    "transform": {
      "\\.txt$": "jest-expo/src/preset/assetFileTransformer.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|uuid))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "engines": {
    "node": "^22.13 || ^24.3 || ^26"
  },
  "packageManager": "bun@1.3.5",
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-device-hub"
      ],
      "android": {
        "exclude": [
          "expo-maps"
        ]
      }
    },
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "react-native-gesture-handler",
        "typescript"
      ]
    }
  },
  "patchedDependencies": {
    "expo-speech-transcriber@0.1.9": "patches/expo-speech-transcriber@0.1.9.patch"
  }
}
