{
  "name": "pixel-tracker",
  "version": "1.88.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "prepare": "husky",
    "start": "EXPO_PUBLIC_APP_VARIANT=development expo start --dev-client",
    "android": "bun scripts/run-native.ts android",
    "ios": "bun scripts/run-native.ts ios",
    "ios:preview": "EXPO_PUBLIC_APP_VARIANT=preview bun scripts/run-native.ts ios --configuration Release --no-bundler",
    "android:preview": "EXPO_PUBLIC_APP_VARIANT=preview bun scripts/run-native.ts android --variant release --no-bundler",
    "app": "bun scripts/cli/index.ts app",
    "e2e": "bun scripts/cli/index.ts e2e",
    "simulators": "bun scripts/cli/index.ts simulators",
    "builds": "bun scripts/cli/index.ts builds",
    "devices": "bun scripts/cli/index.ts devices",
    "dashboard": "bun scripts/cli/dashboard.ts",
    "web": "EXPO_PUBLIC_APP_VARIANT=development expo start --web",
    "test": "jest --watchAll --env=jsdom",
    "test:ci": "jest --env=jsdom",
    "eas:ios:dev": "bunx eas-cli build -p ios --local --profile=development",
    "eas:android:dev": "bunx eas-cli build -p android --local --profile=development",
    "eas:ios:emulator": "bunx eas-cli build -p ios --profile=emulator",
    "eas:android:emulator": "bunx eas-cli build -p android --profile=emulator",
    "eas:ios:preview": "bunx eas-cli build -p ios --local --profile=preview",
    "eas:android:preview": "bunx eas-cli build -p android --local --profile=preview",
    "eas:ios:prod": "bunx eas-cli build -p ios --local --profile=production",
    "eas:android:prod": "bunx eas-cli build -p android --local --profile=production",
    "submit": "bunx eas-cli submit -p android --path $(ls -t *.aab | head -1) && bunx eas-cli submit -p ios --path $(ls -t *.ipa | head -1)",
    "eas:preview": "bun run eas:ios:preview && bun run eas:android:preview",
    "eas:prod": "bun run eas:ios:prod && bun run eas:android:prod",
    "translate-app": "bun scripts/generate-translations-app.js",
    "reviews": "node scripts/store-reviews.mjs",
    "type-check": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check && bun run type-check",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "^2.3.2",
    "chroma-js": "^3.2.0",
    "dayjs": "^1.11.7",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-observe": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-superwall": "1.2.0",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fast-xml-parser": "^5.10.1",
    "i18n-js": "^4.5.3",
    "lodash": "^4.17.21",
    "lucide-react-native": "^0.562.0",
    "posthog-react-native": "^4.75.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-feather": "^1.1.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "4.5.5",
    "react-native-reanimated-carousel": "^5.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-style-utilities": "^1.0.1",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "5.1.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.4",
    "semver": "^7.5.2",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@google-cloud/translate": "^10.1.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/i18n-js": "^4.0.1",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.10",
    "agent-device": "0.21.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "ultracite": "7.12.0"
  },
  "overrides": {
    "markdown-it": "^15.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "./__tests__/utils.ts"
    ]
  },
  "engines": {
    "node": ">=22.13 <27"
  },
  "packageManager": "bun@1.3.5"
}
