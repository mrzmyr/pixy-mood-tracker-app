{
  "name": "pixel-tracker",
  "version": "1.86.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest --watchAll --env=jsdom",
    "test:ci": "jest --env=jsdom",
    "build:ios:dev": "bunx eas-cli build -p ios --local --profile=development",
    "build:android:dev": "bunx eas-cli build -p android --local --profile=development",
    "build:ios:emulator": "bunx eas-cli build -p ios --profile=emulator",
    "build:android:emulator": "bunx eas-cli build -p android --profile=emulator",
    "build:ios:preview": "bunx eas-cli build -p ios --local --profile=preview",
    "build:android:preview": "bunx eas-cli build -p android --local --profile=preview",
    "build:ios:prod": "bunx eas-cli build -p ios --local --profile=production",
    "build:android:prod": "bunx eas-cli build -p android --local --profile=production",
    "submit:preview": "bunx eas-cli submit -p android --path $(ls -t *.aab | head -1) && bunx eas-cli submit -p ios --path $(ls -t *.ipa | head -1)",
    "submit:prod": "bunx eas-cli submit -p android --path $(ls -t *.aab | head -1) && bunx eas-cli submit -p ios --path $(ls -t *.ipa | head -1)",
    "build:preview": "bun run build:ios:preview && bun run build:android:preview",
    "build:prod": "bun run build:ios:prod && bun run build:android:prod",
    "translate-app": "bun scripts/generate-translations-app.js",
    "type-check": "tsc"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "./__tests__/utils.ts"
    ],
    "collectCoverage": false,
    "collectCoverageFrom": [
      "./hooks/*.{js,jsx,ts,tsx}",
      "./helpers/*.{js,jsx,ts,tsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/jest.setup.js"
    ]
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/hooks": "^2.8.1",
    "@react-navigation/bottom-tabs": "^6.3.1",
    "@react-navigation/native": "^6.0.2",
    "@react-navigation/native-stack": "^6.9.7",
    "@sentry/react-native": "~7.11.0",
    "buffer": "^6.0.3",
    "chroma-js": "^2.4.2",
    "dayjs": "^1.11.7",
    "expo": "~57.0.9",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "fast-xml-parser": "^5.10.1",
    "i18n-js": "^3.8.0",
    "jotai": "^2.0.2",
    "lodash": "^4.17.21",
    "lucide-react-native": "^0.562.0",
    "posthog-react-native": "^4.61.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-feather": "^1.1.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-carousel": "^5.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-style-utilities": "^1.0.1",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "semver": "^7.5.2",
    "use-debounce": "^9.0.4",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-react": "^7.18.6",
    "@google-cloud/translate": "^9.4.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/i18n-js": "^3.8.2",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.14.195",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.3",
    "mockdate": "^3.0.5",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13 <27"
  },
  "packageManager": "bun@1.3.5",
  "overrides": {
    "markdown-it": "^15.0.0"
  }
}
