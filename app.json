{
  "expo": {
    "name": "Pixy",
    "slug": "pixy-mood-tracker",
    "version": "1.107.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pixy",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.devmood.pixymoodtracker",
      "appleTeamId": "8VVNC4724B",
      "supportsTablet": false,
      "appStoreUrl": "https://apps.apple.com/de/app/pixy-mood-tracker/id1605327124",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "SKIncludeConsumableInAppPurchaseHistory": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics",
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCustomerSupport",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.devmood.pixymoodtracker",
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.devmood.pixymoodtracker"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-standby.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-standby.png",
            "backgroundColor": "#171717"
          },
          "imageWidth": 48
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "ar",
            "cs",
            "da",
            "de",
            "el",
            "es",
            "fi",
            "fr",
            "he",
            "hi",
            "hr",
            "hu",
            "id",
            "it",
            "ja",
            "ko",
            "ms",
            "nb",
            "nl",
            "pl",
            "pt",
            "ro",
            "ru",
            "sk",
            "sv",
            "th",
            "tr",
            "uk",
            "vi",
            "zh-Hans"
          ]
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-document-picker",
        {
          "appleTeamId": "8VVNC4724B"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Tangerine",
            "ios": "./assets/images/app-icons/tangerine.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/tangerine-foreground.png",
              "backgroundImage": "./assets/images/app-icons/tangerine-background.png"
            }
          },
          {
            "name": "TangerineInverse",
            "ios": "./assets/images/app-icons/tangerine-inverse.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/tangerine-inverse-foreground.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "Sky",
            "ios": "./assets/images/app-icons/sky.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/sky-foreground.png",
              "backgroundImage": "./assets/images/app-icons/sky-background.png"
            }
          }
        ]
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Pixy lists your contacts so you can add people. Only the people you pick are saved, with name and photo, on your device."
        }
      ],
      [
        "expo-speech-transcriber",
        {
          "speechRecognitionPermission": "Pixy turns what you say into a check-in note and finds people, tags, and emotions in it. Speech is processed on your device.",
          "microphonePermission": "Pixy listens while you talk about your day to write your check-in. Audio is never saved."
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pixy adds photos you choose to your entries and people. Photos stay on your device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Pixy adds photos you choose to your entries and people. Photos stay on your device.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pixy adds the place where you check in to your entry. Pixy stores the place on your device and asks Apple Maps for its name.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Pixy does not use motion data. Our location tool includes this permission, but Pixy never asks for it."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pixy uses Face ID to unlock the app when App Lock is on."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Pixy reads your sleep to suggest how well you slept when you check in. Your sleep data stays on your iPhone.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "./tools/expo-plugins/with-apple-health-icon.cjs"
    ],
    "buildCacheProvider": {
      "plugin": "./scripts/build-cache-provider.cjs"
    },
    "extra": {
      "eas": {
        "projectId": "8917be91-f1cc-4276-a252-674a28490ac3"
      }
    },
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "web": {
      "output": "single"
    }
  }
}
