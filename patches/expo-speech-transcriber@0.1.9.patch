diff --git a/node_modules/expo-speech-transcriber/ios/LiveAnalyzer.swift b/ios/LiveAnalyzer.swift
new file mode 100644
index 0000000000000000000000000000000000000000..e15d8bcf3aa36fcc6479e347bfbfacc579ce86ad
--- /dev/null
+++ b/ios/LiveAnalyzer.swift
@@ -0,0 +1,147 @@
+import AVFoundation
+import Foundation
+import Speech
+
+/// Live, on-device transcription with SpeechAnalyzer (iOS 26+).
+/// Works without Siri, unlike SFSpeechRecognizer on-device mode.
+/// Volatile results report the running range; final results end one range.
+@available(iOS 26.0, *)
+final class LiveAnalyzer {
+  typealias TextHandler = (_ text: String, _ isFinal: Bool) -> Void
+  typealias LevelHandler = (_ level: Float) -> Void
+  typealias ErrorHandler = (_ message: String, _ code: String) -> Void
+
+  private let engine = AVAudioEngine()
+  private var analyzer: SpeechAnalyzer?
+  private var inputContinuation: AsyncStream<AnalyzerInput>.Continuation?
+  private var resultsTask: Task<Void, Never>?
+  private var isRunning = false
+
+  static var isSupported: Bool { SpeechTranscriber.isAvailable }
+
+  func start(
+    localeIdentifier: String?,
+    onText: @escaping TextHandler,
+    onLevel: @escaping LevelHandler,
+    onError: @escaping ErrorHandler
+  ) async {
+    await stop()
+    let requested = localeIdentifier.map { Locale(identifier: $0) } ?? Locale.current
+    guard let locale = await SpeechTranscriber.supportedLocale(equivalentTo: requested) else {
+      onError("SpeechTranscriber has no model for locale \(requested.identifier)", "recognizer_unavailable")
+      return
+    }
+    let transcriber = SpeechTranscriber(
+      locale: locale,
+      transcriptionOptions: [],
+      reportingOptions: [.volatileResults],
+      attributeOptions: []
+    )
+    do {
+      // Downloads the language model from Apple once. No user data leaves the device.
+      if let request = try await AssetInventory.assetInstallationRequest(supporting: [transcriber]) {
+        try await request.downloadAndInstall()
+      }
+    } catch {
+      onError("Speech model download failed: \(error.localizedDescription) locale=\(locale.identifier)", "on_device_unavailable")
+      return
+    }
+    guard let analyzerFormat = await SpeechAnalyzer.bestAvailableAudioFormat(compatibleWith: [transcriber]) else {
+      onError("No audio format for SpeechTranscriber", "transcription_failed")
+      return
+    }
+
+    do {
+      let session = AVAudioSession.sharedInstance()
+      try session.setCategory(.record, mode: .measurement, options: [])
+      try session.setActive(true, options: .notifyOthersOnDeactivation)
+    } catch {
+      onError(error.localizedDescription, "transcription_failed")
+      return
+    }
+
+    let (stream, continuation) = AsyncStream<AnalyzerInput>.makeStream()
+    inputContinuation = continuation
+    let analyzer = SpeechAnalyzer(modules: [transcriber])
+    self.analyzer = analyzer
+
+    resultsTask = Task {
+      do {
+        for try await result in transcriber.results {
+          onText(String(result.text.characters), result.isFinal)
+        }
+      } catch is CancellationError {
+      } catch {
+        onError("\(error.localizedDescription) locale=\(locale.identifier)", "transcription_failed")
+      }
+    }
+
+    let inputNode = engine.inputNode
+    let inputFormat = inputNode.outputFormat(forBus: 0)
+    guard let converter = AVAudioConverter(from: inputFormat, to: analyzerFormat) else {
+      onError("Cannot convert microphone audio", "transcription_failed")
+      await stop()
+      return
+    }
+    var lastLevelAt = Date.distantPast
+    inputNode.removeTap(onBus: 0)
+    inputNode.installTap(onBus: 0, bufferSize: 4096, format: inputFormat) { buffer, _ in
+      let now = Date()
+      if now.timeIntervalSince(lastLevelAt) >= 0.05, let channel = buffer.floatChannelData?[0], buffer.frameLength > 0 {
+        lastLevelAt = now
+        let count = Int(buffer.frameLength)
+        var sum: Float = 0
+        for i in 0..<count { sum += channel[i] * channel[i] }
+        let db = 20 * log10(max(sqrt(sum / Float(count)), 0.000_01))
+        onLevel(max(0, min(1, (db + 50) / 50)))
+      }
+      let ratio = analyzerFormat.sampleRate / inputFormat.sampleRate
+      let capacity = AVAudioFrameCount(Double(buffer.frameLength) * ratio) + 1
+      guard let converted = AVAudioPCMBuffer(pcmFormat: analyzerFormat, frameCapacity: capacity) else { return }
+      var consumed = false
+      var conversionError: NSError?
+      converter.convert(to: converted, error: &conversionError) { _, status in
+        if consumed {
+          status.pointee = .noDataNow
+          return nil
+        }
+        consumed = true
+        status.pointee = .haveData
+        return buffer
+      }
+      if conversionError == nil, converted.frameLength > 0 {
+        continuation.yield(AnalyzerInput(buffer: converted))
+      }
+    }
+
+    do {
+      try await analyzer.start(inputSequence: stream)
+      engine.prepare()
+      try engine.start()
+      isRunning = true
+    } catch {
+      onError("\(error.localizedDescription) locale=\(locale.identifier)", "transcription_failed")
+      await stop()
+    }
+  }
+
+  func stop() async {
+    if engine.isRunning {
+      engine.stop()
+    }
+    engine.inputNode.removeTap(onBus: 0)
+    inputContinuation?.finish()
+    inputContinuation = nil
+    if let analyzer = analyzer {
+      // Finalize so the last volatile range arrives as a final result.
+      try? await analyzer.finalizeAndFinishThroughEndOfInput()
+    }
+    analyzer = nil
+    resultsTask?.cancel()
+    resultsTask = nil
+    if isRunning {
+      isRunning = false
+      try? AVAudioSession.sharedInstance().setActive(false, options: .notifyOthersOnDeactivation)
+    }
+  }
+}
