 public class WidgetsEvents {
   public static let shared = WidgetsEvents()
 
+  // Events posted before JS subscribes, for example when iOS launches the app
+  // in the background to run a Live Activity intent. Delivered on subscribe.
+  private let lock = NSLock()
+  private var isObserved = false
+  private var pending: [[String: Any]] = []
+  private let maxPending = 50
+
   private init() {}
 
   public func sendNotification(type: WidgetsEventType, data: [String: Any]) {
     var eventData = data
     eventData["type"] = type.rawValue
+    lock.lock()
+    if !isObserved {
+      pending.append(eventData)
+      if pending.count > maxPending {
+        pending.removeFirst()
+      }
+      lock.unlock()
+      return
+    }
+    lock.unlock()
     let userInfo = ["eventData": eventData] as [String: Any]
     NotificationCenter.default.post(name: onUserInteractionNotification, object: nil, userInfo: userInfo)
   }
+
+  /// Marks JS as subscribed and returns the events that waited for it.
+  func startObserving() -> [[String: Any]] {
+    lock.lock()
+    defer { lock.unlock() }
+    isObserved = true
+    let events = pending
+    pending = []
+    return events
+  }
+
+  func stopObserving() {
+    lock.lock()
+    defer { lock.unlock() }
+    isObserved = false
+  }
+
+  /// True while events wait for a JS subscriber.
+  var hasPending: Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return !pending.isEmpty
+  }
